# =====================================
#  Linux + VSCode + C/C++ TCP/IP Project
# =====================================

# --- Normalize line endings to LF ---
* text=auto eol=lf

# --- Ensure UTF-8 encoding for source files ---
*.c text working-tree-encoding=UTF-8
*.cpp text working-tree-encoding=UTF-8
*.h text working-tree-encoding=UTF-8
*.hpp text working-tree-encoding=UTF-8
*.txt text working-tree-encoding=UTF-8
*.md text working-tree-encoding=UTF-8

# --- Treat binary files properly ---
*.o binary
*.a binary
*.so binary
*.bin binary
*.elf binary
*.hex binary
*.png binary
*.jpg binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary
